@* Mapeamento da rota do componente *@
@page "/criar-usuario"

<div class="d-flex align-items-baseline justify-content-center vh-100 bg-light">
    <div class="card shadow p-4" style="width: 22rem;">
        <div class="card-body">
            <h3 class="card-title text-center mb-2 mt-2">Criação de conta de usuário</h3>

            @if (!string.IsNullOrEmpty(mensagemErro))
            {
                <div class="alert alert-danger mb-2 alert-dismissible" role="alert">
                    <strong>@mensagemErro</strong>
                    <button @onclick="FecharJanelaErro" type="button" class="btn-close" aria-label="Close"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(mensagemSucesso))
            {
                <div class="alert alert-success mb-2 alert-dismissible" role="alert">
                    <strong>@mensagemSucesso</strong>
                    <button @onclick="FecharJanelaErro" type="button" class="btn-close" aria-label="Close"></button>
                </div>
            }

            <EditForm Model="@model" OnValidSubmit="@OnSubmit">

                @* Habilitar e executar as validações do DataAnnotations *@
                <DataAnnotationsValidator />

                <div class="mb-2">
                    <label for="nome" class="form-label">Nome do usuário</label>
                    <InputText type="nome" class="form-control" id="nome" placeholder="Digite seu nome" @bind-Value="model.Nome" />
                    <span class="text-danger">
                        <ValidationMessage For="@(() => model.Nome)" />
                    </span>
                </div>
                <div class="mb-2">
                    <label for="email" class="form-label">Email de acesso</label>
                    <InputText type="email" class="form-control" id="email" placeholder="Digite seu email" @bind-Value="model.Email" />
                    <span class="text-danger">
                        <ValidationMessage For="@(() => model.Email)" />
                    </span>
                </div>
                <div class="mb-2">
                    <label for="senha" class="form-label">Senha de acesso</label>
                    <InputText type="password" class="form-control" id="senha" placeholder="Digite sua senha" @bind-Value="model.Senha" />
                    <span class="text-danger">
                        <ValidationMessage For="@(() => model.Senha)" />
                    </span>
                </div>
                <div class="mb-2">
                    <label for="confirmarSenha" class="form-label">Confirme a senha</label>
                    <InputText type="password" formControlName="confirmarSenha" class="form-control" id="confirmarSenha" placeholder="Confirme sua senha" @bind-Value="model.SenhaConfirmacao" />
                    <span class="text-danger">
                        <ValidationMessage For="@(() => model.SenhaConfirmacao)" />
                    </span>
                </div>
                <div class="mb-2">
                    <input type="submit" class="btn btn-primary w-100" value="Realizar Cadastro" />
                </div>
                <div class="mb-2">
                    <NavLink class="btn btn-secondary w-100 mt-2">
                        Acesse sua conta de usuário
                    </NavLink>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@using Newtonsoft.Json
@using ProdutosApp.UI.Configurations
@using ProdutosApp.UI.Models

@inject HttpClient Http
@inject IHttpClientFactory _httpClientFactory;

@code {
    string mensagemSucesso = string.Empty;
    string mensagemErro = string.Empty;

    //criando um objeto da classe de modelo de dados
    CriarUsuarioModel model = new CriarUsuarioModel();

    //função executada no evento SUBMIT do formulário
    public async Task OnSubmit()
    {
        mensagemSucesso = string.Empty;
        mensagemErro = string.Empty;

        try
        {
            using (HttpClient httpClient = _httpClientFactory.CreateClient(HttpClientName.UsersAPI))
            {
                var response = await httpClient.PostAsJsonAsync("api/usuarios/criar-usuario", model);

                if(response.IsSuccessStatusCode)
                {
                    mensagemSucesso = $"Parabéns, {model.Nome}, sua conta foi criada com sucesso!";

                    //limpando os campos do formulário
                    model = new CriarUsuarioModel();
                }
                else
                {
                    var content = await response.Content.ReadAsStringAsync();
                    var error = JsonConvert.DeserializeObject<ErrorModel>(content);

                    mensagemErro = error.Message;
                }
            }
        }
        catch (Exception ex)
        {
            mensagemErro = ex.Message;
        }
    }

    public async Task FecharJanelaErro()
    {
        mensagemSucesso = string.Empty;
        mensagemErro = string.Empty;
    }
}
